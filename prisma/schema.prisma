generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model categoria {
  id       BigInt     @id(map: "pk_categoria")
  nombre   String     @unique(map: "uq_categoria_nombre") @db.VarChar(100)
  activa   Boolean    @default(true)
  producto producto[]
}

model cliente {
  id              BigInt           @id(map: "pk_cliente")
  nombre          String           @db.VarChar(150)
  documento       String?          @unique(map: "uq_cliente_documento") @db.VarChar(30)
  telefono        String?          @db.VarChar(50)
  activo          Boolean          @default(true)
  cuentacorriente cuentacorriente?
  venta           venta[]
}

model cuentacorriente {
  id                        BigInt                      @id(map: "pk_cuentacorriente")
  clienteid                 BigInt                      @unique(map: "uq_cuentacorriente_cliente")
  cliente                   cliente                     @relation(fields: [clienteid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cuentacorriente_cliente")
  cuentacorrientemovimiento cuentacorrientemovimiento[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cuentacorrientemovimiento {
  id                BigInt          @id(map: "pk_cuentacorrientemovimiento")
  cuentacorrienteid BigInt
  ventaid           BigInt?
  productoid        BigInt?
  fecha             DateTime        @default(now()) @db.Timestamp(6)
  tipo              Int
  cantidad          Decimal?        @db.Decimal(12, 3)
  importe           Decimal         @db.Decimal(12, 2)
  cuentacorriente   cuentacorriente @relation(fields: [cuentacorrienteid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ccm_cuentacorriente")
  producto          producto?       @relation(fields: [productoid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ccm_producto")
  venta             venta?          @relation(fields: [ventaid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ccm_venta")

  @@index([cuentacorrienteid], map: "ix_ccm_cuentacorrienteid")
  @@index([fecha], map: "ix_ccm_fecha")
  @@index([productoid], map: "ix_ccm_productoid")
  @@index([ventaid], map: "ix_ccm_ventaid")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model detalleventa {
  id             BigInt   @id(map: "pk_detalleventa")
  ventaid        BigInt
  productoid     BigInt
  cantidad       Decimal  @db.Decimal(12, 3)
  preciounitario Decimal  @db.Decimal(12, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
  producto       producto @relation(fields: [productoid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalleventa_producto")
  venta          venta    @relation(fields: [ventaid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalleventa_venta")

  @@index([productoid], map: "ix_detalleventa_productoid")
  @@index([ventaid], map: "ix_detalleventa_ventaid")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model producto {
  id                        BigInt                      @id(map: "pk_producto")
  categoriaid               BigInt
  nombre                    String                      @db.VarChar(150)
  codigobarra               String?                     @unique(map: "uq_producto_codigobarra") @db.VarChar(50)
  preciolista               Decimal                     @default(0) @db.Decimal(12, 2)
  permitestock              Boolean                     @default(true)
  stockactual               Decimal                     @default(0) @db.Decimal(12, 3)
  activo                    Boolean                     @default(true)
  cuentacorrientemovimiento cuentacorrientemovimiento[]
  detalleventa              detalleventa[]
  categoria                 categoria                   @relation(fields: [categoriaid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_producto_categoria")

  @@index([categoriaid], map: "ix_producto_categoriaid")
}

model usuario {
  id      BigInt  @id(map: "pk_usuario")
  nombre  String  @db.VarChar(150)
  usuario String  @unique(map: "uq_usuario_usuario") @db.VarChar(100)
  activo  Boolean @default(true)
  venta   venta[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model venta {
  id                        BigInt                      @id(map: "pk_venta")
  fecha                     DateTime                    @default(now()) @db.Timestamp(6)
  clienteid                 BigInt?
  usuarioid                 BigInt
  tipopago                  Int
  total                     Decimal                     @default(0) @db.Decimal(12, 2)
  cuentacorrientemovimiento cuentacorrientemovimiento[]
  detalleventa              detalleventa[]
  cliente                   cliente?                    @relation(fields: [clienteid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_venta_cliente")
  usuario                   usuario                     @relation(fields: [usuarioid], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_venta_usuario")

  @@index([clienteid], map: "ix_venta_clienteid")
  @@index([fecha], map: "ix_venta_fecha")
  @@index([usuarioid], map: "ix_venta_usuarioid")
}
