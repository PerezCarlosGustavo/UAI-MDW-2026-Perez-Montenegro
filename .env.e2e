# Las variables de `npm run test:e2e`.
#
# Este archivo se commitea a propósito: no tiene ningún secreto. Todo apunta a
# una base local que se levanta y se tira, y este secreto no firma ninguna
# sesión de verdad. playwright.config.ts no arranca si la base no es local.
#
# La base se levanta con Docker, una sola vez:
#   docker run -d --name almacen-e2e -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=almacen -p 54329:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/almacen"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/almacen"

AUTH_SECRET="secreto-de-las-pruebas-e2e-no-sirve-para-nada-mas"
NEXTAUTH_SECRET="secreto-de-las-pruebas-e2e-no-sirve-para-nada-mas"
NEXTAUTH_URL="http://localhost:3100"

# Google no se usa: las pruebas fabrican la cookie de sesión (e2e/preparar.ts).
AUTH_GOOGLE_ID="e2e"
AUTH_GOOGLE_SECRET="e2e"

# Un storage que no responde, a propósito: las pruebas no suben archivos a
# ningún lado, y de paso recorren el camino de la venta sin comprobante.
SUPABASE_URL="http://127.0.0.1:9"
SUPABASE_SERVICE_ROLE_KEY="e2e"

ADMIN_EMAIL="admin@e2e.test"

PRISMA_HIDE_UPDATE_MESSAGE="1"
